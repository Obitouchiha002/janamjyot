node_modules/
build/
dist/
coverage/
.data/
.DS_Store
*.log
.env*
!.env.example
.vercel/
*.local
.vercel

# ── Android build output (regenerated by `cap sync` + gradle) ──────────────
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/release/
# Web assets Capacitor copies in — rebuilt from dist/, never edited by hand
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Built APK lives on the site, not in git (11 MB binary, regenerated each build)
public/*.apk

# Server bundle emitted by build-server.mjs
server-bundle.mjs
server.cjs
server.cjs.map

# over-the-air web bundles (built by npm run ota:publish, deployed, not committed)
public/ota/*.zip

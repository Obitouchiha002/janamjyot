# ──────────────────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in real values.
# .env.local is git-ignored and is read ONLY by the backend (server.ts).
# NONE of these values are ever exposed to the browser / frontend bundle.
# ──────────────────────────────────────────────────────────────────────────

# Prokerala Astrology API (Client Credentials OAuth2).
# Get these from https://api.prokerala.com/account/client
PROKERALA_CLIENT_ID=your_client_id_here
PROKERALA_CLIENT_SECRET=your_client_secret_here

# Ayanamsa for sidereal calculations: 1 = Lahiri (default), 3 = Raman, 5 = KP
PROKERALA_AYANAMSA=1

# AI providers for interpretation/chat (never used for calculation).
# Add as many as you like — they are tried in order and the app automatically
# falls back to the next provider when one hits its quota/rate limit.

# YOUR OWN LOCAL AI (Ollama) — no API key, no limits, free & offline. Tried FIRST.
# Install from https://ollama.com/download, run `ollama pull llama3.1`, then set:
OLLAMA_MODEL=            # e.g. llama3.1  (or qwen2.5:14b for better quality)
# OLLAMA_BASE_URL=http://localhost:11434/v1

GEMINI_API_KEY=your_gemini_api_key_here
# Optional additional / backup providers:
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Gemini models, BEST first. Tried highest→lowest; on a limit it drops to the next.
GEMINI_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.0-flash
GROQ_API_KEY=            # free & fast — https://console.groq.com/keys
OPENROUTER_API_KEY=      # many free models — https://openrouter.ai/keys
OPENAI_API_KEY=          # OpenAI or any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=       # Claude — paid backup, tried LAST (when all free run out)
# ANTHROPIC_MODEL=claude-opus-4-8   # or claude-sonnet-4-6 / claude-haiku-4-5
# AI_PROVIDER_ORDER=gemini,groq,openrouter,openai,anthropic   # customise fallback order

# Google Sign-In (backend token verification).
# The OAuth **Web client id(s)** that /api/auth/google will accept. Comma-
# separate if you use more than one (e.g. web + Android use the SAME web id).
# The FRONTEND needs the same value as VITE_GOOGLE_CLIENT_ID in .env.local /
# your build env; Android additionally needs the app's SHA-1 registered on
# that OAuth client in Google Cloud. Leave blank to keep Google Sign-In off.
GOOGLE_CLIENT_IDS=

# Postgres / Supabase connection string.
# Supabase: Project Settings -> Database -> Connection string (URI). Use the
# "Connection pooling" (port 6543) URI for serverless, or 5432 for a long-lived server.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "true" if your Postgres requires TLS (most managed providers, incl.
# Supabase, do). Accepts a self-signed cert chain.
DATABASE_SSL=true

# ── TEXT-TO-SPEECH (Google Gemini TTS) ─────────────────────────────────────────
# Natural voice for the "Listen / Speak" buttons. The key stays server-side and
# is NEVER shipped in the app. By default TTS reuses GEMINI_API_KEY above; set
# GEMINI_TTS_API_KEY only if you want a separate key just for voice.
#   Voices are Gemini prebuilt voice names — change them freely.
GEMINI_TTS_API_KEY=
GEMINI_TTS_VOICE_MAIN=Algieba
GEMINI_TTS_VOICE_CHAT=Alnilam
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ---------------------------------------------------------------------------
# Sessions & admin
# ---------------------------------------------------------------------------
# Signs the HS256 session JWTs. MUST be set in production — without it the
# server falls back to a per-machine dev value and sessions break across
# serverless instances. Generate: openssl rand -hex 32
AUTH_SECRET=replace_with_openssl_rand_hex_32

# The account treated as admin (gets the Admin panel).
ADMIN_EMAIL=you@example.com

# Public base URL, used to build password-reset links in e-mails.
PUBLIC_APP_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Outgoing e-mail (password reset, sign-in codes, contact form)
# Gmail: create an APP PASSWORD (not your normal password).
# ---------------------------------------------------------------------------
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
CONTACT_TO=you@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ---------------------------------------------------------------------------
# FRONTEND values — these ARE bundled into the app/browser, so they must be
# public-safe. Never put a secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------
# Backend the Android app calls. Leave EMPTY for web (same-origin); it MUST be
# the deployed URL for the APK build or every API call fails.
VITE_API_BASE=https://your-app.vercel.app
# OAuth *Web* client id — public by design (same value as GOOGLE_CLIENT_IDS).
VITE_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Public APK download link used by the Share buttons.
VITE_APP_DOWNLOAD_URL=https://your-app.vercel.app/YourApp.apk

    "sync:app": "node scripts/prune-app-dist.mjs && cap sync android",
    "check:failover": "tsx server/__checks__/failover.ts",
    "check:day-signals": "tsx server/__checks__/day-signals.ts",
    "check:hindu-calendar": "tsx server/__checks__/hindu-calendar.ts",
